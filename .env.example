# Copy to .env (git-ignored) and fill in. Load with: uv run --env-file .env python ...
# Never commit real credentials. Blank values fall back to the defaults shown in comments.

# --- Paid LLM (deferred pilot; only with owner approval of a cost estimate) ---
ANTHROPIC_API_KEY=

# --- Services (Phase 6). compose.dev.yaml publishes them on 127.0.0.1 only. ---
POSTGRES_PASSWORD=retrieval_labs
DATABASE_URL=postgresql+psycopg://retrieval_labs:retrieval_labs@127.0.0.1:55432/retrieval_labs
REDIS_URL=redis://127.0.0.1:56379/0

# --- Application settings (retrieval_labs.config.Settings) ---
# bm25 | dense | hybrid | hybrid+rerank (default; D-001). bm25 loads no models.
RETRIEVER=hybrid+rerank
# fake (default, free) | anthropic (paid: requires LLM_MAX_USD, a cap per worker lifetime)
LLM_PROVIDER=fake
LLM_MAX_USD=
# Per-job time limit; jobs RUNNING 2 minutes past it are marked worker_lost (D-003).
JOB_TIMEOUT_S=900
MAX_UPLOAD_BYTES=2000000
# DEBUG | INFO | WARNING | ERROR. Logs are JSON lines on stdout and never contain contract text.
LOG_LEVEL=INFO
# Keep 127.0.0.1: the API has no authentication (only Docker binds 0.0.0.0 inside the container).
API_HOST=127.0.0.1
API_PORT=8000

# --- Integration tests (they wipe this database; its name must end in _test) ---
TEST_DATABASE_URL=postgresql+psycopg://retrieval_labs:retrieval_labs@127.0.0.1:55432/retrieval_labs_test
TEST_REDIS_URL=redis://127.0.0.1:56379/0
